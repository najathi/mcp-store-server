# Copy to .env and change every token. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

# SQLite file. Default: ./data/store.db inside the project (created and seeded on first run).
# DATABASE_PATH=./data/store.db

# --- HTTP transport -------------------------------------------------------
# Comma-separated name:token:scopes entries. Scopes: read, write (join with | or +).
# The name is what appears in the audit log. Tokens must be at least 16 characters.
API_TOKENS=analyst:change-me-read-token-0001:read,ops-bot:change-me-write-token-0002:read|write

HTTP_HOST=127.0.0.1
HTTP_PORT=3000
# When binding to 0.0.0.0 (e.g. Docker), list the host names (no port) clients use.
# localhost and 127.0.0.1 are always allowed. This guards against DNS rebinding.
# ALLOWED_HOSTS=mcp.example.com

# --- stdio transport (Claude Desktop, Claude Code, Cursor) ----------------
# There is no token on stdio, so the scopes come from here. Read-only by default.
STDIO_ACTOR=local-user
STDIO_SCOPES=read

# --- Guards ---------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
CONFIRM_TTL_SECONDS=120
